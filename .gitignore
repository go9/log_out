# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
chat_logger-*.tar

# Temporary files, for example, from tests.
/tmp/

# flicker agent config — generated by `flicker harness sync` from the
# flicker library. AGENTS.md is committed (harnesses/CI/collaborators read it);
# the projected skill payloads are regenerable and are not.
.flicker-agent/
.flicker/
.claude/

# agent session scratch (pi-subagents, impeccable critique)
.pi-subagents/
.impeccable/

# Workspace-synced agent skills (flicker harness sync --workspace)
.pi/skills/

# flicker agent config (projected by `flicker harness sync`; the source of truth is flicker)
.pi/
.opencode/
